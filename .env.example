# Copy to .env and edit. Never commit .env.

PN_NODE_ID=phantomnet-01

# Address the decoy ports bind to on the host. Keep 127.0.0.1 for local testing;
# change to the approved dedicated decoy address only after isolation is applied.
DECOY_BIND_IP=127.0.0.1
DECOY_SSH_PORT=2222
DECOY_HTTP_PORT=8080
DECOY_MYSQL_PORT=33060
DECOY_SUBNET=10.77.30.0/24

# Dashboard (always loopback; use an SSH tunnel or VPN to reach it).
DASHBOARD_PORT=8800
PN_ADMIN_USER=admin
# Required. Generate with: openssl rand -base64 24
PN_ADMIN_PASSWORD=

# Optional alert destinations.
PN_WEBHOOK_URL=
PN_SMTP_HOST=
PN_SMTP_PORT=587
PN_SMTP_USER=
PN_SMTP_PASSWORD=
PN_SMTP_FROM=
PN_SMTP_TO=

OPENCANARY_VERSION=0.9.5

# Optional: manage this sensor from the PhantomNet cloud console.
# In the console run `sensor add <name>` and paste the two values it prints.
PN_CLOUD_URL=
PN_ENROLL_CODE=
